{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/skills/code-better/hooks/guard.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/skills/code-better/hooks/guard.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
